      "$ignoreUnknownInstances": true,
      "Core": {"$path": "src/ReplicatedStorage/Core"},
      "Combat": {"$path": "src/ReplicatedStorage/Combat"}
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$ignoreUnknownInstances": true,
