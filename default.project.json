      "Combat": {"$path": "src/ServerScriptService/Combat"},
      "Dungeon": {"$path": "src/ServerScriptService/Dungeon"}
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$ignoreUnknownInstances": true,
      "$properties": {"EnableMouseLockOption": false},
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "$ignoreUnknownInstances": true,
        "Core": {"$path": "src/StarterPlayerScripts/Core"},
        "Combat": {"$path": "src/StarterPlayerScripts/Combat"},
        "Dungeon": {"$path": "src/StarterPlayerScripts/Dungeon"}
      }
    }
