--!strict
local ServerScriptService=game:GetService("ServerScriptService")
local Core=ServerScriptService:WaitForChild("Core")
local Adapters=Core:WaitForChild("Adapters")
local Services=Core:WaitForChild("Services")
local InMemoryProfileAdapter=require(Adapters:WaitForChild("InMemoryProfileAdapter"))
local ProfileService=require(Services:WaitForChild("ProfileService"))
local InventoryService=require(Services:WaitForChild("InventoryService"))
local LoadoutService=require(Services:WaitForChild("LoadoutService"))
local SkillProgressionService=require(Services:WaitForChild("SkillProgressionService"))
local n=0
local function check(v:boolean,m:string) n+=1 if not v then error("[Skill Progression Service Tests] "..m,2) end end
local profiles=ProfileService.new(InMemoryProfileAdapter.new()); assert(profiles:load(9301))
assert(profiles:mutate(9301,function(profile) profile.Characters.Slot1.Progression.SkillPointEntitlement=9 end))
local inventory=InventoryService.new(profiles); local loadout=LoadoutService.new(profiles); local skills=SkillProgressionService.new(profiles,inventory,loadout)
check(skills:get_available_sp(9301)==9,"fresh Level 10-style entitlement must expose 9 SP")
local mend2=skills:purchase_rank(9301,"Mend")
check(mend2.ok==false and mend2.reason=="ProficiencyThresholdNotMet","rank purchase must require proficiency threshold")
assert(profiles:mutate(9301,function(profile) profile.Characters.Slot1.Progression.Skills.Mend.Proficiency=100 end))
mend2=skills:purchase_rank(9301,"Mend")
check(mend2.ok and skills:get_available_sp(9301)==8,"Mend Rank 2 must cost one SP")
check(inventory:add_item(9301,"arc_slash_book_bound",1).ok,"test Arc Slash book must be addable")
local learned=skills:learn_skill(9301,"Prototype","ArcSlash","arc_slash_book_bound")
check(learned.ok and skills:get_available_sp(9301)==5,"Arc Slash Rank 1 must consume book and 3 SP")
local before=skills:get_available_sp(9301); local respec=skills:respec_skills(9301); local after=skills:get_available_sp(9301)
local c=assert(profiles:get_character(9301,1))
check(respec.ok and after<=9 and after>before,"respec may refund allocations but never exceed lifetime entitlement")
check(c.Progression.Skills.Mend.PurchasedRank==1 and c.Progression.Skills.ShieldBash.PurchasedRank==1,"free starter Rank 1 skills must survive skill respec")
check(c.Progression.Skills.ArcSlash.Known==true and c.Progression.Skills.ArcSlash.PurchasedRank==0,"consumed book knowledge survives while refunded skill becomes inactive")
check(c.Progression.RespecCounters.Skills==1 and c.Progression.RespecCounters.Attributes==0,"skill respec must increment only skill counter")
local again=skills:respec_skills(9301); check(again.ok and skills:get_available_sp(9301)==9,"repeated respec cannot mint SP")
print(string.format("[Skill Progression Service Tests] PASS: %d assertions.",n))
