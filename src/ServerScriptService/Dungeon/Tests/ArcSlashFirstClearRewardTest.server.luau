--!strict
local ServerScriptService=game:GetService("ServerScriptService")
local Core=ServerScriptService:WaitForChild("Core")
local Adapters=Core:WaitForChild("Adapters")
local Services=Core:WaitForChild("Services")
local InMemoryProfileAdapter=require(Adapters:WaitForChild("InMemoryProfileAdapter"))
local ProfileService=require(Services:WaitForChild("ProfileService"))
local InventoryService=require(Services:WaitForChild("InventoryService"))
local LoadoutService=require(Services:WaitForChild("LoadoutService"))
local SkillProgressionService=require(Services:WaitForChild("SkillProgressionService"))
local assertions=0
local function check(v:boolean,m:string) assertions+=1 if not v then error("[Arc Slash First Clear Reward Tests] "..m,2) end end
local adapter=InMemoryProfileAdapter.new(); local profiles=ProfileService.new(adapter); assert(profiles:load(7201))
local inventory=InventoryService.new(profiles); local loadout=LoadoutService.new(profiles); local skills=SkillProgressionService.new(profiles,inventory,loadout)
local first=skills:grant_arc_slash_first_clear(7201,"session-a:ArcSlashFirstClear")
local second=skills:grant_arc_slash_first_clear(7201,"session-a:ArcSlashFirstClear")
local c=assert(profiles:get_character(7201,1))
check(first.ok==true and first.already_applied==false,"first eligible clear must grant the book.")
check(second.ok==true and second.already_applied==true,"repeat grant must be idempotent.")
check(InventoryService.count_item(c,"arc_slash_book_bound")==1,"one-time reward must never create a duplicate book.")
check(c.Progression.OneTimeRewards.ArcSlashFirstClear==true,"persistent one-time flag must be committed with the book.")
assert(profiles:save(7201,"RewardTest")); assert(profiles:release(7201,"RewardTest")); assert(profiles:load(7201))
local third=skills:grant_arc_slash_first_clear(7201,"session-b:ArcSlashFirstClear")
c=assert(profiles:get_character(7201,1))
check(third.ok==true and third.already_applied==true and InventoryService.count_item(c,"arc_slash_book_bound")==1,"save/reload must preserve exactly-once reward behavior.")
print(string.format("[Arc Slash First Clear Reward Tests] PASS: %d assertions.",assertions))
