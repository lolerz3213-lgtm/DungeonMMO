--!strict
local ServerScriptService = game:GetService("ServerScriptService")
local Base = ServerScriptService:WaitForChild("Base")
local Core = ServerScriptService:WaitForChild("Core")
local Adapters = Core:WaitForChild("Adapters")
local Services = Core:WaitForChild("Services")
local ControllerModule = Base:FindFirstChild("BaseProgressionController")
if not ControllerModule then error("[Base Progression Controller Tests] RED: BaseProgressionController is missing.") end
local BaseProgressionController = require(ControllerModule)
local InMemoryProfileAdapter = require(Adapters:WaitForChild("InMemoryProfileAdapter"))
local ProfileService = require(Services:WaitForChild("ProfileService"))
local InventoryService = require(Services:WaitForChild("InventoryService"))
local AttributeService = require(Services:WaitForChild("AttributeService"))
local LoadoutService = require(Services:WaitForChild("LoadoutService"))
local SkillProgressionService = require(Services:WaitForChild("SkillProgressionService"))
local assertions=0
local function check(v:boolean,m:string) assertions+=1 if not v then error("[Base Progression Controller Tests] "..m,2) end end
local profiles=ProfileService.new(InMemoryProfileAdapter.new()); assert(profiles:load(6101))
assert(profiles:mutate(6101,function(profile) local c=profile.Characters.Slot1; c.Level=10; c.Progression.AttributePointEntitlement=9; c.Progression.SkillPointEntitlement=9 end))
local inventory=InventoryService.new(profiles)
local attributes=AttributeService.new(profiles)
local loadout=LoadoutService.new(profiles)
local skills=SkillProgressionService.new(profiles,inventory,loadout)
local controller=BaseProgressionController.new({context="Base",profiles=profiles,inventory=inventory,attributes=attributes,loadout=loadout,skills=skills})
local snapshot=controller:build_snapshot(6101)
check(snapshot.Level==10 and snapshot.APAvailable==9 and snapshot.SPAvailable==9,"snapshot must expose Level/AP/SP.")
local committed=controller:commit_attributes(6101,{Strength=6,Dexterity=5,Vitality=5,Intellect=5,Spirit=5})
check(committed.ok==true and controller:build_snapshot(6101).Attributes.Strength==6,"Base controller must atomically commit valid attribute previews.")
local invalid=controller:commit_attributes(6101,{Strength=99,Dexterity=5,Vitality=5,Intellect=5,Spirit=5})
check(invalid.ok==false and controller:build_snapshot(6101).Attributes.Strength==6,"invalid attribute commit must preserve previous state.")
local dungeon_controller=BaseProgressionController.new({context="Dungeon",profiles=profiles,inventory=inventory,attributes=attributes,loadout=loadout,skills=skills})
local rejected=dungeon_controller:respec_attributes(6101)
check(rejected.ok==false and rejected.reason=="BaseOnlyAction","permanent progression mutations must reject outside Base.")
check(inventory:add_item(6101,"arc_slash_book_bound",1).ok,"test Arc Slash book must be granted.")
local learned=controller:learn_skill(6101,"ArcSlash")
check(learned.ok==true and controller:build_snapshot(6101).Skills.ArcSlash.Rank==1,"trainer controller must consume book and learn Arc Slash.")
local changed=controller:set_loadout(6101,{"Mend","ShieldBash","ArcSlash"})
check(changed.ok==true and controller:build_snapshot(6101).Loadout[3]=="ArcSlash","Base controller must accept valid six-slot loadout changes.")
local moved=controller:move_skill_to_slot(6101,"Mend",3)
local moved_snapshot=controller:build_snapshot(6101)
check(moved.ok==true and moved_snapshot.Loadout[3]=="Mend" and moved_snapshot.Loadout[1]==false,"controller move must relocate selected skill using server-authoritative state.")
local gap=controller:move_skill_to_slot(6101,"ShieldBash",6)
local gap_snapshot=controller:build_snapshot(6101)
check(gap.ok==true and gap_snapshot.Loadout[6]=="ShieldBash","last slot must remain exact")
for slot=1,6 do
    check(gap_snapshot.Loadout[slot]~=nil,"wire snapshot must contain every slot, including empty gaps")
end
check(gap_snapshot.Loadout[1]==false and gap_snapshot.Loadout[2]==false and gap_snapshot.Loadout[3]=="Mend","wire gaps must be explicit without moving skills")
print(string.format("[Base Progression Controller Tests] PASS: %d assertions.",assertions))
